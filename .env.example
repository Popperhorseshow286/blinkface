# 复制为 .env 后按本机填写。`.env` 已被 gitignore，不会进仓库。
# 也可用 export / 系统环境变量；已存在的环境变量优先于 .env。

# API 根地址（Mac 客户端 / 前端代理用）
# 例: http://192.168.1.10:8000  或  http://gpu-box:8000  或  http://100.x.x.x:8000
BLINKFACE_HOST=http://127.0.0.1:8000

# server.py 监听（默认只绑本机；局域网/ tailnet 访问时再改 0.0.0.0）
BLINKFACE_BIND=127.0.0.1
BLINKFACE_PORT=8000

# 可选共享密钥：非空时 /generate 需要请求头
#   Authorization: Bearer <token>
# 或 X-Blinkface-Token: <token>
# CLI 与 web-serve 会自动带上同一变量。
# BLINKFACE_TOKEN=

# 可选安全上限
# BLINKFACE_MAX_SIDE=1280
# BLINKFACE_MAX_STEPS=28

# 可选模型 id（默认 FLUX.2-klein-4B）
# BLINKFACE_MODEL=black-forest-labs/FLUX.2-klein-4B

# restart.sh：SSH 主机名（~/.ssh/config）与远端项目目录
BLINKFACE_SSH_HOST=gpu-box
BLINKFACE_REMOTE_DIR=C:/path/to/blinkface
BLINKFACE_REMOTE_PYTHON=C:/path/to/blinkface/.venv/Scripts/python.exe
BLINKFACE_REMOTE_HF_HOME=C:/path/to/blinkface/hf-cache

# 可选：Hugging Face（下载模型时）
# HF_TOKEN=
# HF_HOME=
# HF_HUB_DISABLE_XET=1
# HF_HUB_OFFLINE=1
